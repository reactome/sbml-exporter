CREATE (:`Complex`:`DatabaseObject`:`Deletable`:`PhysicalEntity`:`Trackable` {`dbId`: 9613533, `displayName`: "p-PLINs:HSPA8 [lipid droplet]", `isChimeric`: false, `isInDisease`: false, `maxDepth`: 3, `name`: ["p-PLINs:HSPA8"], `schemaClass`: "Complex", `speciesName`: "Homo sapiens", `stId`: "R-HSA-9613533", `stIdVersion`: "R-HSA-9613533.1"});
