CREATE (:`DatabaseObject`:`LiteratureReference`:`Publication` {`dbId`: 9613334, `displayName`: "Breaking fat: The regulation and mechanisms of lipophagy", `journal`: "Biochim. Biophys. Acta", `pages`: "1178-1187", `pubMedIdentifier`: 28642194, `schemaClass`: "LiteratureReference", `title`: "Breaking fat: The regulation and mechanisms of lipophagy", `volume`: 1862, `year`: 2017});
CREATE (:`DatabaseObject`:`Summation` {`dbId`: 9613336, `displayName`: "Lipophagy is the process of autophagic degradation of lipid ...", `schemaClass`: "Summation", `text`: "Lipophagy is the process of autophagic degradation of lipid droplets into fatty acids. A key step in this process is the elimination of perilipin (PLIN) proteins on lipid droplet surface. This mechanism is initiated when the cytosolic Heat shock cognate 71 kDa protein (HSPA8) binds PLIN2 and PLIN3 on the lipid droplet surface. Consequently, perilipins are phosphorylated and targeted to degradation making the lipid available for hydrolysis (S Kaushik et al. 2015). Experiments confirming this interaction were performed in rats."});
CREATE (:`DatabaseObject`:`Deletable`:`EntityWithAccessionedSequence`:`GenomeEncodedEntity`:`PhysicalEntity`:`Trackable` {`dbId`: 9613337, `displayName`: "PLIN3 [lipid droplet]", `endCoordinate`: 434, `isInDisease`: false, `maxDepth`: 1, `name`: ["PLIN3"], `referenceType`: "ReferenceGeneProduct", `schemaClass`: "EntityWithAccessionedSequence", `speciesName`: "Homo sapiens", `stId`: "R-HSA-9613337", `stIdVersion`: "R-HSA-9613337.1", `startCoordinate`: 1});
CREATE (:`DatabaseObject`:`Summation` {`dbId`: 9613344, `displayName`: "Triglycerides stored in lipid droplets are hydrolysed under ...", `schemaClass`: "Summation", `text`: "Triglycerides stored in lipid droplets are hydrolysed under nutrient starvation to release fatty acids for energy. The content of lipid droplets may vary but they are all coated with a protective protein called perilipin. When this protein is degraded, lipid droplets associate with autophagic components and breakdown into fatty acids (Ward C et al. 2016, Schulze R J et al. 2017). This process is termed as lipophagy (Singh R et al. 2009)."});
CREATE (:`DatabaseObject`:`Deletable`:`EntityWithAccessionedSequence`:`GenomeEncodedEntity`:`PhysicalEntity`:`Trackable` {`dbId`: 9613345, `displayName`: "PLIN2 [lipid droplet]", `endCoordinate`: 437, `isInDisease`: false, `maxDepth`: 1, `name`: ["PLIN2", "Perilipin-2"], `referenceType`: "ReferenceGeneProduct", `schemaClass`: "EntityWithAccessionedSequence", `speciesName`: "Homo sapiens", `stId`: "R-HSA-9613345", `stIdVersion`: "R-HSA-9613345.2", `startCoordinate`: 1});
