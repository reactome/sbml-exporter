CREATE (:`Complex`:`DatabaseObject`:`Deletable`:`PhysicalEntity`:`Trackable` {`dbId`: 9613508, `displayName`: "PLINs:HSPA8:PRKAA2 [lipid droplet]", `isChimeric`: false, `isInDisease`: false, `maxDepth`: 4, `name`: ["PLINs:HSPA8:PRKAA2"], `schemaClass`: "Complex", `speciesName`: "Homo sapiens", `stId`: "R-HSA-9613508", `stIdVersion`: "R-HSA-9613508.1"});
CREATE (:`DatabaseObject`:`Summation` {`dbId`: 9613511, `displayName`: "Lipophagy is the process of autophagic degradation of lipid ...", `schemaClass`: "Summation", `text`: "Lipophagy is the process of autophagic degradation of lipid droplets into fatty acids. Lipid droplets are coated with perilipin (PLIN) protiens and they need to be eliminated for the degradation of the lipids inside. Cytosolic Heat shock cognate 71 kDa protein (HSPA8) binds PLIN2 and PLIN3 on the lipid droplet surface. Consequently, PRKAA2 bind and phosphorylate perilipins targeting them for lipophagy (S Kaushik et al. 2015, S Kaushik et al. 2016). Experiments confirming this interaction were performed in mouse."});
CREATE (:`DatabaseObject`:`Deletable`:`Event`:`Reaction`:`ReactionLikeEvent`:`Trackable` {`category`: "binding", `dbId`: 9613513, `displayName`: "PLINs:HSPA8 binds PRKAA2", `isChimeric`: false, `isInDisease`: false, `isInferred`: true, `maxDepth`: 1, `name`: ["PLINs:HSPA8 binds PRKAA2"], `releaseDate`: "2019-06-12", `schemaClass`: "Reaction", `speciesName`: "Homo sapiens", `stId`: "R-HSA-9613513", `stIdVersion`: "R-HSA-9613513.4"});
